# Copy this file to .env and fill in real values.
# .env is git-ignored; this example file is safe to commit.

# --- PostgreSQL ---
POSTGRES_USER=feedback
POSTGRES_PASSWORD=change-me
POSTGRES_DB=feedback

# --- Email alerts (detractor notifications) ---
# Defaults point at the local Mailpit container (inbox UI: http://localhost:8025).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=feedback@companyx.test
CARE_TEAM_EMAIL=care@companyx.test
# Optional: also text the care rep about detractors (E.164, e.g. +254712345678)
CARE_TEAM_PHONE=

# --- Africa's Talking SMS sandbox ---
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
# Random string; add ?token=<value> to the callback URL in the AT dashboard.
AT_WEBHOOK_TOKEN=
# Optional USSD service code from the AT dashboard, e.g. *384*12345#. SMS invites mention it.
AT_USSD_CODE=

# --- AI layer (bonus) ---
# AI layer (optional). AI_PROVIDER is openai or anthropic; the key comes from that
# provider's console. Leave AI_API_KEY empty to switch AI off - feedback, alerts and
# the dashboard all still work. AI_MODEL empty = gpt-5.4-mini / claude-opus-5-5.
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=
# Local demos without a key: keyword rules stand in for the AI (labelled as demo).
AI_DEMO_MODE=false

# Owner login for the admin dashboard. Plain text here; the backend stores only a hash,
# in the database, and re-syncs it on every startup. At least 10 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SESSION_SECRET=
COOKIE_SECURE=false
