# Server-side secrets for staging/production. Copy to deploy/.env ON THE SERVER only,
# and use different values for staging and production.
# (Comments stay on their own lines: some .env parsers treat "# ..." after a value as part of it.)

# Public address. A domain (e.g. staging.companyx.example) gets automatic HTTPS.
SITE_ADDRESS=:80
FRONTEND_ORIGIN=https://staging.companyx.example

# Long random password, e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_USER=feedback
POSTGRES_PASSWORD=
POSTGRES_DB=feedback

# A real SMTP provider (there is no Mailpit in production)
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=feedback@companyx.example
CARE_TEAM_EMAIL=
CARE_TEAM_PHONE=

AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
AT_WEBHOOK_TOKEN=
# Optional USSD service code from the AT dashboard, e.g. *384*12345#. SMS invites mention it.
AT_USSD_CODE=

# AI layer (optional). AI_PROVIDER is openai or anthropic; the key comes from that
# provider's console. Leave AI_API_KEY empty to switch AI off - feedback, alerts and
# the dashboard all still work. AI_MODEL empty = gpt-5.4-mini / claude-opus-5-5.
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=

# Owner login. The backend hashes ADMIN_PASSWORD into the database on every startup.
# Use a long random password here: this file sits on the server in plain text.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# 32+ random characters
SESSION_SECRET=
# true needs HTTPS (a domain in SITE_ADDRESS); false only for plain-HTTP tests
COOKIE_SECURE=true
