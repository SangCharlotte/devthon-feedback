# Server-side secrets for staging/production. Copy to deploy/.env ON THE SERVER only,
# and use different values for staging and production.
# (Comments stay on their own lines: some .env parsers treat "# ..." after a value as part of it.)

# Public address. A domain (e.g. staging.companyx.example) gets automatic HTTPS.
SITE_ADDRESS=:80
FRONTEND_ORIGIN=https://staging.companyx.example

# Long random password, e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_USER=feedback
POSTGRES_PASSWORD=
POSTGRES_DB=feedback

# A real SMTP provider (there is no Mailpit in production)
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=feedback@companyx.example
CARE_TEAM_EMAIL=
CARE_TEAM_PHONE=

AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
AT_WEBHOOK_TOKEN=

# AI layer (optional): an Anthropic API key from console.anthropic.com.
# Leave empty to switch AI off - feedback, alerts and the dashboard all still work.
AI_API_KEY=
AI_MODEL=claude-opus-5-5

# Hash: docker compose -f docker-compose.prod.yml --env-file .env --env-file release.env
#       run --rm --no-deps backend python -m app.auth hash-password
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# 32+ random characters
SESSION_SECRET=
# true needs HTTPS (a domain in SITE_ADDRESS); false only for plain-HTTP tests
COOKIE_SECURE=true
